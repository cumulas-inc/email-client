{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cumulas Mail",
  "mainBinaryName": "cumulas-mail",
  "version": "0.5.0",
  "identifier": "co.cumulas.Mail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Cumulas Mail",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "font-src": "'self' data: https:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Office",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "shortDescription": "Mail, calendar, contacts and tasks",
    "longDescription": "A fast desktop mail client for Linux with Microsoft 365, Outlook.com and IMAP accounts, plus calendar, contacts and tasks.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"],
        "desktopTemplate": "linux/cumulas-mail.desktop.hbs"
      },
      "rpm": {
        "depends": ["libayatana-appindicator-gtk3"],
        "desktopTemplate": "linux/cumulas-mail.desktop.hbs"
      }
    }
  }
}
